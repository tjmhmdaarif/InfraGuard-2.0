# Data Source
VITE_APP_TITLE=InfraGuard
VITE_MQTT_BROKER=tcp://localhost:1883
VITE_MQTT_USERNAME=infraguard_user
VITE_MQTT_PASSWORD=change_me
VITE_INFLUXDB_URL=http://localhost:8086
VITE_INFLUXDB_ORG=infraguard
VITE_INFLUXDB_BUCKET=telemetry
VITE_INFLUXDB_TOKEN=your-token-here
VITE_DATA_SOURCE=SIMULATION

# Serial
VITE_SERIAL_PORT=COM4
VITE_SERIAL_BAUDRATE=115200

# Render / Performance
VITE_MAX_PIXEL_RATIO=2
VITE_ENABLE_SHADOWS=true
VITE_ENABLE_BLOOM=true

# Feature Flags
VITE_ENABLE_REPLAY=true
VITE_ENABLE_IMPORT=true
VITE_DEVELOPER_MODE=false
